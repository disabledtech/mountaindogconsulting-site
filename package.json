{
  "name": "mountaindog-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mountain Dog Consulting marketing site — static, accessibility-first, near-zero-JS.",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "deploy": "wrangler deploy",
    "audit:axe": "axe ./dist --dir",
    "audit:pa11y": "pa11y-ci --sitemap ./dist/sitemap-index.xml",
    "audit:lhci": "npx --yes @lhci/cli@latest autorun",
    "audit:lhci:mobile": "npx --yes @lhci/cli@latest autorun --config=./lighthouserc.mobile.json"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.3",
    "astro-compressor": "^1.3.0",
    "mdast-util-to-string": "^4.0.0",
    "reading-time": "^1.5.0"
  },
  "devDependencies": {
    "@axe-core/cli": "^4.11.3",
    "lightningcss": "^1.32.0",
    "pa11y-ci": "^5.0.0",
    "wrangler": "^4.88.0"
  },
  "overrides": {
    "tmp": "^0.2.6",
    "uuid": "^11.1.1",
    "inquirer": "^9.3.7",
    "external-editor": "^3.1.0",
    "lodash": "^4.18.1",
    "devalue": "^5.9.3",
    "basic-ftp": "^6.2.3"
  }
}
