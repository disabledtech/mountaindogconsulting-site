---
/**
 * SiteHeader — global header with logo lockup + primary navigation.
 *
 * The Mountain Dog horizontal lockup is inlined as SVG (via ?raw import) so
 * fill="currentColor" works — that lets the same SVG render in navy on the
 * off-white header without needing a second file for dark surfaces. The
 * brand application is orange-on-navy in the existing site, but on a light
 * header the WCAG-locked palette forbids orange-on-off-white (1.65 ratio) —
 * navy-on-off-white at 12.92 (AAA) is the right call.
 *
 * Accessibility:
 * - The link gets `aria-label="Mountain Dog Consulting — home"` so the
 *   accessible name is unambiguous; the inlined SVG is hidden from AT.
 * - <header> + <nav aria-label="Primary"> establish landmarks.
 *
 * Architecture (post 2026-05-21 pivot):
 * - Home (/) is the blog index; the wordmark links there.
 * - /about/ holds services, bio, contact as anchor sections.
 * - Services and Contact in the nav are deep links into /about/.
 * - When rendered on /about/ itself, anchors target the current page (#services)
 *   rather than re-routing (/about/#services), keeping the in-page jump snappy.
 */
import logoLockupSvg from '../assets/logo/lockup-horizontal.svg?raw';

export interface Props {
  /** When true, anchor links target same-page (#services); otherwise /about/#services. */
  onAboutPage?: boolean;
}

const { onAboutPage = false } = Astro.props;
const prefix = onAboutPage ? '' : '/about/';
---
<header class="site-header">
  <div class="site-header__inner">
    <a href="/" class="site-header__wordmark" aria-label="Mountain Dog Consulting — home">
      <span class="site-header__logo" aria-hidden="true" set:html={logoLockupSvg} />
    </a>

    <nav aria-label="Primary" class="site-header__nav">
      <ul role="list" class="site-header__nav-list">
        <li><a href="/about/">About</a></li>
        <li><a href={`${prefix}#services`}>Services</a></li>
        <li><a href={`${prefix}#contact`}>Contact</a></li>
      </ul>
    </nav>
  </div>
</header>
