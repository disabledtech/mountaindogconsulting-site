---
/**
 * Homepage — blog index after 2026-05-21 pivot.
 *
 * Composition (top-down):
 *   1. Short intro block: who I am + what I write about + link to /about/
 *   2. Heading "Recent writing"
 *   3. Reverse-chronological post list (title-as-link + date + reading time + description)
 *
 * Phase 1c lock: don't make whole-card links (screen readers read all the
 * card content as the link's accessible name). Only the post title is a
 * link. The date and description are sibling elements.
 *
 * Drafts are filtered out at build time. Posts are sorted by pubDate
 * descending so the freshest post is the top of the list.
 */
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

// Reading time isn't free on the listing — it's attached via remark plugin at
// render time, not collected at frontmatter time. Pre-render each post so we
// can show "2 min read" in the list without a second build pass.
const postsWithMeta = await Promise.all(
  posts.map(async (post) => {
    const { remarkPluginFrontmatter } = await render(post);
    return {
      slug: post.id,
      data: post.data,
      readingTime: remarkPluginFrontmatter?.minutesRead as string | undefined,
    };
  })
);

const dateFormatter = new Intl.DateTimeFormat('en-CA', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const title = 'Mountain Dog Consulting — Notes on assistive technology';
const description = "Taylor Danielson's notes on assistive technology, accessibility, and the projects and tools that come out of consulting practice in British Columbia.";
---
<BaseLayout title={title} description={description}>
  <section class="home-intro" aria-labelledby="home-intro-heading">
    <div class="home-intro__inner">
      <h1 id="home-intro-heading">
        Notes on assistive technology, accessibility, and the work itself.
      </h1>
      <p class="home-intro__lede">
        I'm Taylor Danielson — an assistive technology consultant and public
        speaker based in British Columbia. I write here about projects I've
        built, devices and tools worth knowing about, and the questions I keep
        running into in the work.
      </p>
      <p>
        <a href="/about/" class="home-intro__about-link">About Taylor &rarr;</a>
      </p>
    </div>
  </section>

  <section class="post-list" aria-labelledby="post-list-heading">
    <div class="post-list__inner">
      <h2 id="post-list-heading">Recent writing</h2>

      {postsWithMeta.length === 0 ? (
        <p>No posts yet. Check back soon, or
          <a href="/rss.xml">subscribe via RSS</a>.</p>
      ) : (
        <ul role="list" class="post-list__items">
          {postsWithMeta.map((post) => {
            const year = post.data.pubDate.getFullYear();
            const href = `/${year}/${post.slug}/`;
            const dateISO = post.data.pubDate.toISOString();
            return (
              <li class="post-list__item">
                <article>
                  <h3 class="post-list__title">
                    <a href={href}>{post.data.title}</a>
                  </h3>
                  <p class="post-list__meta">
                    <time datetime={dateISO}>{dateFormatter.format(post.data.pubDate)}</time>
                    {post.readingTime && (
                      <>
                        <span class="post-list__meta-sep" aria-hidden="true">·</span>
                        <span>{post.readingTime}</span>
                      </>
                    )}
                  </p>
                  <p class="post-list__excerpt">{post.data.description}</p>
                </article>
              </li>
            );
          })}
        </ul>
      )}

      <p class="post-list__rss">
        <a href="/rss.xml">Subscribe via RSS</a>
      </p>
    </div>
  </section>
</BaseLayout>
